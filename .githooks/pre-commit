#!/bin/sh
# U167: privacy gate — refuses to commit personal/sensitive data.
#
# Activated once per clone with:   git config core.hooksPath .githooks
# (CI runs the same scanner over the full tree as the enforced backstop, so
# bypassing this locally with --no-verify still gets caught on push.)

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v py >/dev/null 2>&1; then
  PY="py -3"
else
  echo "pre-commit: python not found - skipping privacy scan (CI will still enforce it)"
  exit 0
fi

$PY "$(git rev-parse --show-toplevel)/scripts/privacy_scan.py" --staged

# U299: a unit owes its spec in the same commit. This only warns — the check
# that BLOCKS is `scripts/spec_drift.py` in CI, which reads commit subjects and
# so cannot run before the commit exists. Here we can only see the staged files,
# and "code without spec" is worth saying out loud while it is still cheap.
CODE=$(git diff --cached --name-only --diff-filter=ACM        -- 'apps/*' 'services/*' 'packages/*' | head -1)
SPEC=$(git diff --cached --name-only --diff-filter=ACM -- '.specify/specs/*' | head -1)
if [ -n "$CODE" ] && [ -z "$SPEC" ]; then
  echo "pre-commit: code is changing and no spec is."
  echo "            Constitution I: specs are living artifacts - update them"
  echo "            when reality diverges. See 'what a unit owes' in CLAUDE.md,"
  echo "            AGENTS.md or .github/copilot-instructions.md - all three"
  echo "            carry the same block, generated from"
  echo "            docs/agent-working-agreement.md."
fi
