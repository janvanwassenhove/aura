[Unit]
# U241: the robot follows release tags by itself. Installed by
# `python scripts/deploy_robot.py --enable-auto-update`; remove the timer to
# stop it. Logs: journalctl -u aura-robot-update
Description=AURA robot self-update (release tags only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pollen
WorkingDirectory=/home/pollen/aura
# Deliberately NOT the copy in the checkout: that file is replaced by the very
# git reset this script performs, and it disappears entirely when the robot is
# older than the script itself.
ExecStart=/usr/local/bin/aura-robot-selfupdate
# It restarts a service and syncs dependencies; give it room, but never let it
# hang around holding the machine.
TimeoutStartSec=1800
